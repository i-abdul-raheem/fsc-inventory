generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id           String           @id @default(cuid()) @map("_id")
  email        String           @unique
  name         String?
  passwordHash String
  role         String           @default("OPERATOR")
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  permissions  UserPermission[]
}

model Permission {
  id        String           @id @default(cuid()) @map("_id")
  code      String           @unique
  userLinks UserPermission[]
}

/// Join table: MongoDB connector does not support compound @@id — use surrogate id + @@unique.
model UserPermission {
  id           String     @id @default(cuid()) @map("_id")
  userId       String
  permissionId String
  assignedAt   DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
}

// Buyer / site in Saudi Arabia — link orders for traceability.
model Customer {
  id          String       @id @default(cuid()) @map("_id")
  name        String
  tradingName String?
  email       String?
  phone       String?
  city        String?
  region      String?
  addressLine String?
  vatNumber   String?
  notes       String?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  orders      SalesOrder[]
}

// Component / material supplier (often overseas).
model Seller {
  id          String   @id @default(cuid()) @map("_id")
  name        String
  tradingName String?
  email       String?
  phone       String?
  city        String?
  country     String?  @default("Saudi Arabia")
  vatNumber   String?
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Item {
  id                 String               @id @default(cuid()) @map("_id")
  sku                String               @unique
  name               String
  description        String?
  kind               String // COMPONENT | KIT
  active             Boolean              @default(true)
  lowStockAlertBelow Int?
  standardCostCents  Int?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  bomAsKit           BillOfMaterialLine[] @relation("KitItem")
  bomAsPart          BillOfMaterialLine[] @relation("ComponentItem")
  stock              StockLevel?
  orderLines         SalesOrderLine[]
  reservations       Reservation[]
  needs              ProcurementNeed[]
}

model BillOfMaterialLine {
  id              String @id @default(cuid()) @map("_id")
  kitItemId       String
  componentItemId String
  qtyPerKit       Int

  kit       Item @relation("KitItem", fields: [kitItemId], references: [id], onDelete: Cascade)
  component Item @relation("ComponentItem", fields: [componentItemId], references: [id], onDelete: Restrict)

  @@unique([kitItemId, componentItemId])
}

model StockLevel {
  id        String @id @default(cuid()) @map("_id")
  itemId    String @unique
  qtyOnHand Int    @default(0)
  item      Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model SalesOrder {
  id                  String              @id @default(cuid()) @map("_id")
  customerId          String?
  customer            Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerPoRef       String?
  customerName        String
  status              String              @default("DRAFT")
  internalPickSlipRef String?           @unique
  fulfilledAt         DateTime?
  shippedAt           DateTime?
  shippedCarrierNote  String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  lines               SalesOrderLine[]
  procurementNeeds    ProcurementNeed[]
  reservations        Reservation[]
  salePosting         SalePosting?

  @@index([customerId])
}

model SalesOrderLine {
  id           String     @id @default(cuid()) @map("_id")
  salesOrderId String
  itemId       String
  quantity     Int
  unitPrice    Int?

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  item       Item       @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([salesOrderId])
}

model Reservation {
  id           String     @id @default(cuid()) @map("_id")
  salesOrderId String
  itemId       String
  qty          Int

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  item       Item       @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([salesOrderId, itemId])
  @@index([itemId])
}

model ProcurementNeed {
  id                String   @id @default(cuid()) @map("_id")
  salesOrderId      String
  itemId            String
  qtyRequired       Int
  qtyOutstanding    Int
  status            String   @default("OPEN")
  supplierReference String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  item       Item       @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([salesOrderId])
  @@index([itemId])
}

model SalePosting {
  id                         String   @id @default(cuid()) @map("_id")
  salesOrderId               String   @unique
  currency                   String   @default("SAR")
  recognizedAt               DateTime?
  revenueRecognizedCents     Int      @default(0)
  costOfGoodsRecognizedCents Int      @default(0)
  memo                       String?

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
}
